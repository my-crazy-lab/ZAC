# ============================================================
# 7. Dữ liệu lớn (không commit — repo còn >2GB)
# ============================================================
# lifemate: audio
lifemate/train+public_test/*/audio/
# lifemate: trạng thái app (environment)
lifemate/train+public_test/*/*_environment/
# lifemate: output của chính ban tổ chức
lifemate/train+public_test/*/submission.jsonl
# datamate: dữ liệu business (xlsx, csv, sqlite)
datamate/train/data/
datamate/public_test/data/
# datamate: file dữ liệu sinh ra khi nạp
*.duckdb
*.sqlite
*.sqlite3
# datamate: submission/benchmark sinh ra khi đo (không commit)
datamate/train/submission*.jsonl
datamate/train/benchmark*.jsonl
datamate/public_test/submission*.jsonl

# Command Code local workspace
.commandcode/
# dump / backup
*.dump
*.bak
