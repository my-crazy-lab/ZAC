# Copy thành `.env` rồi điền giá trị thật. KHÔNG commit file `.env`.
# Endpoint OpenAI-compatible của MiniMax (bắt buộc cho pipeline có LLM).
LIFEMATE_LLM_BASE_URL=https://api.minimax.chat/v1
LIFEMATE_LLM_API_KEY=
LIFEMATE_LLM_MODEL=M3.1-flash
# JSON tuỳ chọn, ví dụ {"chat_template_kwargs":{"enable_thinking":false}}
LIFEMATE_LLM_EXTRA_BODY={}

# Đường dẫn tới gói dữ liệu (mặc định: <repo>/train+public_test)
# LIFEMATE_DATA_ROOT=/abs/path/to/train+public_test
